{
  "name": "gemini-code",
  "version": "0.9.0",
  "description": "Claude-Code-style coding agent that drives the Gemini web UI (3.8 Thinking by default) via Playwright, for people with a Gemini web plan but no API access.",
  "type": "module",
  "scripts": {
    "test": "tsx src/tests/smoke.ts",
    "test:browser": "tsx src/tests/browser-smoke.ts",
    "test:e2e": "tsx src/tests/e2e.ts",
    "open-chrome": "tsx src/scripts/openChrome.ts",
    "login": "tsx src/scripts/login.ts",
    "dev": "tsx src/cli.ts",
    "build": "tsc -p . && node scripts/postbuild.mjs",
    "start": "node dist/cli.js",
    "package": "bash scripts/package-release.sh",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "node scripts/prepare.mjs",
    "setup": "bash setup.sh",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "bin": {
    "gemini-code": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/prepare.mjs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "gemini",
    "ai",
    "cli",
    "coding-agent",
    "playwright",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayxshkumar/gemini-code.git"
  },
  "bugs": {
    "url": "https://github.com/aayxshkumar/gemini-code/issues"
  },
  "homepage": "https://github.com/aayxshkumar/gemini-code#readme"
}
